# Frontend Environment Variables (Public client-side configuration)
# NOTE: All VITE_* variables are bundled into client code. Never store private API secrets or JWT keys here.

# Backend API base URL
VITE_API_BASE_URL=http://localhost:5000/api

# Public Cal.com consultation booking link
VITE_CALCOM_BOOKING_URL=https://cal.com/antarikshacademy/30min?overlayCalendar=true

# Public FormSubmit destination email placeholder
VITE_FORMSUBMIT_EMAIL=your-configured-form-destination@example.com
