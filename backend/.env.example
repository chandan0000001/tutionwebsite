# ==============================================================================
# Antariksh Academy - Backend Environment Configuration Example
# ==============================================================================
# IMPORTANT: In production (Render dashboard), set all values explicitly.
# Never commit real passwords, secrets, or .env files to source control.
# ==============================================================================

# Node Environment: must be strictly one of 'development', 'test', or 'production'
NODE_ENV=development
PORT=5000

# MongoDB Connection String (configured via Render Environment Variables)
MONGODB_URI=mongodb://127.0.0.1:27017/antariksh_academy

# Cryptographically secure random JWT Secret (minimum 32 characters in production)
# Generate using: openssl rand -base64 48
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_characters
JWT_EXPIRES_IN=1d

# Reverse Proxy Configuration:
# On Render, the application runs behind 1 reverse proxy hop.
# Default in production is 1. Can be set to '1', 'loopback', or custom proxy depth.
TRUST_PROXY=1

# Allowed Frontend Origins (CORS):
# In production, specify the exact Vercel frontend URL (comma-separated if multiple)
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=https://antarikshacademy.vercel.app

# Password Hashing Salt Rounds
BCRYPT_SALT_ROUNDS=12

# Initial Administrative & Faculty Credentials (Set your own secure passwords in .env)
SUPERADMIN_USERNAME=admin_user
SUPERADMIN_PASSWORD=RandomSuperAdminPass_987654!

TEACHER_1_USERNAME=faculty_mentor1
TEACHER_1_PASSWORD=RandomTeacher1Pass_123456!

TEACHER_2_USERNAME=faculty_mentor2
TEACHER_2_PASSWORD=RandomTeacher2Pass_654321!
