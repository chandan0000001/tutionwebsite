# Antariksh Academy Environment Configuration Template

# Server Configuration
NODE_ENV=development
PORT=5000

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/antariksh_academy

# Authentication
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_characters
JWT_EXPIRES_IN=1d
BCRYPT_SALT_ROUNDS=12

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173

# Optional Initial Provisioning Passwords (used only when seeding if accounts do not exist)
SUPERADMIN_DEFAULT_PASSWORD=ChangeMeInProduction!123
TEACHER_DEFAULT_PASSWORD=ChangeMeInProduction!456
